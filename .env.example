# 📋 Template de configuration
# Pour démarrer, copie ce fichier et renomme-le en .env, puis remplis les valeurs réelles

# Webhook Discord — génère une nouvelle URL si nécessaire
# Menu serveur → Paramètres → Intégrations → Webhooks
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Discord OAuth2 — pour vérifier les candidats
# Obtiens ça depuis https://discord.com/developers/applications
DISCORD_CLIENT_ID=YOUR_CLIENT_ID_HERE
DISCORD_SERVER_ID=YOUR_SERVER_ID_HERE

# Invite Discord (optionnel mais recommandé)
DISCORD_INVITE_URL=https://discord.gg/YOUR_INVITE_CODE

# Email cible pour le formulaire (fallback si le webhook échoue)
TARGET_EMAIL=your-email@example.com
